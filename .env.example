# Local PostgreSQL. Use the same URL-safe password in both values.
COMPOSE_PROJECT_NAME=tradewinds
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=55432
DATABASE_URL=postgres://tradewinds:replace-with-a-random-password@127.0.0.1:55432/tradewinds?sslmode=disable

# Base64-encoded 32-byte random key. Back it up separately from PostgreSQL.
# Losing this key makes stored account credentials and action journals unreadable.
CREDENTIAL_KEY=

TRADEWINDS_API_URL=https://tradewinds.kibb.io
HTTP_ADDR=127.0.0.1:8585
API_INTERNAL_URL=http://127.0.0.1:8585
LOG_LEVEL=info

# Durable replay tape: real days, independent of seven-day diagnostics; minimum 1.
REPLAY_RETENTION_DAYS=90
# Encrypted payload + manifest byte cap in GiB; monitor physical PostgreSQL size too.
REPLAY_MAX_GIB=20

# Integration tests only: point to a dedicated disposable database.
# TEST_DATABASE_URL=postgres://tradewinds:password@127.0.0.1:55432/tradewinds_test?sslmode=disable
