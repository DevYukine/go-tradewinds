{
  "name": "tradewinds-dashboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3400",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3400",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src next.config.ts vitest.config.mts eslint.config.mjs postcss.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check src next.config.ts vitest.config.mts eslint.config.mjs postcss.config.mjs tsconfig.json package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "9.3.1",
    "leaflet": "1.9.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
